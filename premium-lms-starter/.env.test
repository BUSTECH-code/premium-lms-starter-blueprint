# Test environment — strict separation from development and production.
# In-memory database; JWT_SECRET is generated per test process by the test
# harness (parseEnv) when not supplied. Never reuse development or production
# secrets here.
NODE_ENV=test
API_PORT=4100
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=false
LOG_LEVEL=silent
DB_DRIVER=pglite
DB_PATH=memory:
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
COOKIE_SECURE=false
ALLOW_INSECURE_COOKIES=false
JWT_SECRET=
# Generous defaults so unit/integration tests do not trip limits unless a test
# overrides them explicitly through parseEnv(...).
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=1000
RATE_LIMIT_LOGIN_WINDOW_SECONDS=600
RATE_LIMIT_REGISTER_MAX_ATTEMPTS=1000
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
API_PROXY_TARGET=http://127.0.0.1:4100
# Clearly fake public test key so browser config wiring can be asserted.
# No real Paystack credential is committed or contacted by the test suite.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_lms_unit_test_public_key

# --- Phase 2: catalogue & commerce / Task 1 Paystack ------------------------
# Currency remains OPEN (O-21); NGN is a development placeholder.
STORE_CURRENCY=NGN
# Simulated remains the integration-suite default; Paystack tests override the
# provider with explicit fake sk_test_/pk_test_ keys and a stubbed fetch.
PAYMENT_PROVIDER=simulated
ALLOW_SIMULATED_PAYMENTS=false
SIMULATED_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_API_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=http://localhost:5173/checkout/paystack/callback
CHECKOUT_TTL_MINUTES=30

RATE_LIMIT_CHECKOUT_MAX_ATTEMPTS=1000

# --- Phase 4: signed media delivery -----------------------------------------
# Blank in tests: a deterministic non-production HMAC key is derived from the
# test JWT_SECRET. High limits keep integration suites from tripping rate limits.
MEDIA_SIGNING_SECRET=
RATE_LIMIT_MEDIA_GRANT_MAX_ATTEMPTS=1000
RATE_LIMIT_MEDIA_GRANT_WINDOW_SECONDS=600
RATE_LIMIT_MEDIA_CONTENT_MAX_ATTEMPTS=1000
RATE_LIMIT_MEDIA_CONTENT_WINDOW_SECONDS=600
