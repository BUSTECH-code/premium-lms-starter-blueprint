# Test environment — strict separation from development and production.
# In-memory database; JWT_SECRET is generated per test process by the test
# harness (parseEnv) when not supplied. Never reuse development or production
# secrets here.
NODE_ENV=test
API_PORT=4100
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=false
LOG_LEVEL=silent
DB_DRIVER=pglite
DB_PATH=memory:
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
COOKIE_SECURE=false
ALLOW_INSECURE_COOKIES=false
JWT_SECRET=
# Generous defaults so unit/integration tests do not trip limits unless a test
# overrides them explicitly through parseEnv(...).
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=1000
RATE_LIMIT_LOGIN_WINDOW_SECONDS=600
RATE_LIMIT_REGISTER_MAX_ATTEMPTS=1000
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
API_PROXY_TARGET=http://127.0.0.1:4100

# --- Phase 2: catalogue & commerce ------------------------------------------
# Currency decision is OPEN (O-05/O-21); NGN is a development placeholder.
STORE_CURRENCY=NGN
# Real payment provider is OPEN (O-05); only 'simulated' is supported for now.
# In staging/production simulated payments additionally require
# ALLOW_SIMULATED_PAYMENTS=true and a >=32-char SIMULATED_WEBHOOK_SECRET.
PAYMENT_PROVIDER=simulated
ALLOW_SIMULATED_PAYMENTS=false
SIMULATED_WEBHOOK_SECRET=
CHECKOUT_TTL_MINUTES=30

RATE_LIMIT_CHECKOUT_MAX_ATTEMPTS=1000
