# Premium LMS Starter — environment configuration reference
#
# HOW ENVIRONMENTS ARE SEPARATED
# - The active environment is selected by NODE_ENV (development | test | staging | production).
# - Values are loaded from `.env.<NODE_ENV>` at the repository root (gitignored for
#   staging/production) and/or from process environment (deployment secret management).
# - Committed files: `.env.example` (this file), `.env.development`, `.env.test`.
#   `.env.production` / `.env.staging` are NEVER committed — provide them through the
#   deployment platform's secret store.
# - JWT_SECRET:
#     development  : auto-generated into `.data/secrets/jwt-secret` when unset (gitignored).
#     test         : auto-generated per test process when unset.
#     staging/prod : REQUIRED from process environment. Must be >= 32 chars and must not
#                    be a placeholder. The server refuses to boot without it.
#
# This file documents every supported variable. Copy values into the appropriate
# `.env.<environment>` file or set them in the process environment.

# --- Core -------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
# Comma-separated list of browser origins allowed to call the API with credentials.
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Set true when running behind a reverse proxy that sets X-Forwarded-* headers.
TRUST_PROXY=false
LOG_LEVEL=info

# --- Database ---------------------------------------------------------------
# Phase 1 uses PGlite (real PostgreSQL, embedded). `memory:` = in-memory database.
DB_DRIVER=pglite
DB_PATH=./.data/dev

# --- Authentication ---------------------------------------------------------
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
# Secure (HTTPS-only) cookies. Forced true in production; defaults true in staging.
COOKIE_SECURE=false
# Set true only to allow insecure cookies in a non-production environment (e.g. local TLS-less staging).
ALLOW_INSECURE_COOKIES=false
# REQUIRED in staging/production. Never commit a real value.
JWT_SECRET=

# --- Rate limiting (login / registration) ------------------------------------
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=600
RATE_LIMIT_REGISTER_MAX_ATTEMPTS=10
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600

# --- Web dev server only (apps/web) ------------------------------------------
# Target the Vite dev proxy forwards /api requests to.
API_PROXY_TARGET=http://127.0.0.1:4000

# --- Phase 2: catalogue & commerce ------------------------------------------
# Currency decision is OPEN (O-05/O-21); NGN is a development placeholder.
STORE_CURRENCY=NGN
# Real payment provider is OPEN (O-05); only 'simulated' is supported for now.
# In staging/production simulated payments additionally require
# ALLOW_SIMULATED_PAYMENTS=true and a >=32-char SIMULATED_WEBHOOK_SECRET.
PAYMENT_PROVIDER=simulated
ALLOW_SIMULATED_PAYMENTS=false
SIMULATED_WEBHOOK_SECRET=
CHECKOUT_TTL_MINUTES=30

# Order creation / checkout attempts (per authenticated user)
RATE_LIMIT_CHECKOUT_MAX_ATTEMPTS=30
RATE_LIMIT_CHECKOUT_WINDOW_SECONDS=300

# --- Phase 4: signed media delivery -----------------------------------------
# Dedicated HMAC secret for short-lived signed media URLs and opaque session
# references. REQUIRED in staging/production (>= 32 chars, no placeholders);
# derived from JWT_SECRET in development/test when blank. Never commit a real value.
MEDIA_SIGNING_SECRET=
# Grant issuance per user/lesson, and authenticated media/range requests per session.
RATE_LIMIT_MEDIA_GRANT_MAX_ATTEMPTS=30
RATE_LIMIT_MEDIA_GRANT_WINDOW_SECONDS=300
RATE_LIMIT_MEDIA_CONTENT_MAX_ATTEMPTS=240
RATE_LIMIT_MEDIA_CONTENT_WINDOW_SECONDS=300
