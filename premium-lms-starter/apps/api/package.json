{
  "name": "@lms/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend API: authentication, RBAC, business rules (modular monolith).",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "start": "node dist/index.js",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed:fixtures": "tsx src/scripts/seed-fixtures.ts"
  },
  "dependencies": {
    "@lms/db": "*",
    "@lms/shared": "*",
    "@node-rs/argon2": "^2.2.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "jose": "^6.2.15",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1"
  }
}
