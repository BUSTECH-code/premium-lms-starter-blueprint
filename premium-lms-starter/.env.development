# Development environment — non-secret values only.
# JWT_SECRET is intentionally empty: the loader generates and persists a random
# development secret under .data/secrets/ (gitignored).
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=false
LOG_LEVEL=info
DB_DRIVER=pglite
DB_PATH=./.data/dev
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
COOKIE_SECURE=false
ALLOW_INSECURE_COOKIES=false
JWT_SECRET=
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=600
RATE_LIMIT_REGISTER_MAX_ATTEMPTS=10
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
API_PROXY_TARGET=http://127.0.0.1:4000
# Blank keeps the simulated checkout by default. To exercise Paystack locally,
# set a pk_test_ key here and configure the backend Paystack keys + provider.
VITE_PAYSTACK_PUBLIC_KEY=

# --- Phase 2: catalogue & commerce / Task 1 Paystack ------------------------
# Currency remains OPEN (O-21); NGN is a development placeholder.
STORE_CURRENCY=NGN
# Paystack is the confirmed live provider; simulated stays the local default.
PAYMENT_PROVIDER=simulated
ALLOW_SIMULATED_PAYMENTS=false
SIMULATED_WEBHOOK_SECRET=
# Server-only; supply through local secrets/process env, never commit real keys.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_API_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=http://localhost:5173/checkout/paystack/callback
CHECKOUT_TTL_MINUTES=30

# Order creation / checkout attempts (per authenticated user)
RATE_LIMIT_CHECKOUT_MAX_ATTEMPTS=30
RATE_LIMIT_CHECKOUT_WINDOW_SECONDS=300

# --- Phase 4: signed media delivery -----------------------------------------
# Blank locally: a non-production HMAC key is derived from JWT_SECRET.
MEDIA_SIGNING_SECRET=
RATE_LIMIT_MEDIA_GRANT_MAX_ATTEMPTS=30
RATE_LIMIT_MEDIA_GRANT_WINDOW_SECONDS=300
RATE_LIMIT_MEDIA_CONTENT_MAX_ATTEMPTS=240
RATE_LIMIT_MEDIA_CONTENT_WINDOW_SECONDS=300
